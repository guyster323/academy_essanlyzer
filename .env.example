# cli (default) = demo/test mode: shells out to the locally-installed Claude
#   Code CLI (`claude`), reusing its existing subscription login — no paid
#   API key needed. Requires `claude` to be installed and logged in on this
#   machine (same auth this repo's dev session uses).
# api = production mode: calls the metered Anthropic API directly with
#   ANTHROPIC_API_KEY below (real per-token billing).
AI_PROVIDER=cli

# Only required when AI_PROVIDER=api.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=3001

# Optional. Claude CLI wall-clock timeout in milliseconds. The code default in
# server/lib/claude-cli.js is 1200000 (20 minutes) — a safety ceiling, not a
# performance target. Measured Case B detect-anomaly was 700.9s
# (Report/rank-3-4-findings.md), which exceeds the previous 10-minute default
# and guarantees a 504 on a fresh clone. Override only if you need a different
# ceiling.
# CLAUDE_CLI_TIMEOUT_MS=1200000
