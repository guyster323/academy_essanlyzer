# cli (default) = demo/test mode: shells out to the locally-installed Claude
#   Code CLI (`claude`), reusing its existing subscription login — no paid
#   API key needed. Requires `claude` to be installed and logged in on this
#   machine (same auth this repo's dev session uses).
# api = production mode: calls the metered Anthropic API directly with
#   ANTHROPIC_API_KEY below (real per-token billing).
AI_PROVIDER=cli

# Only required when AI_PROVIDER=api.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=3001

# Optional. Claude CLI wall-clock timeout in milliseconds. The code default in
# server/lib/claude-cli.js is 1800000 (30 minutes) — a safety ceiling, not a
# performance target. Real detect-anomaly runs against the gold Case B prompt
# measured 707.8s / 732.7s / 820.7s / 1139.8s
# (Report/latency-effort-real-outputs/COMPARISON.md), so a 20-minute ceiling
# left only ~60s of margin on the slowest one. Lower it only if you would
# rather fail fast than wait; raising it costs nothing when calls are quick.
# CLAUDE_CLI_TIMEOUT_MS=1800000
